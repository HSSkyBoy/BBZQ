    <string name="custom_download_concurrency_title">自訂同時快取數</string>
    <string name="custom_download_concurrency_summary">目前值：%1$d。點擊調整自訂模式下的並行快取數量。</string>
    <string name="custom_download_concurrency_dialog_title">自訂同時快取數</string>
